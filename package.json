{
  "name": "override-google-maps-account-language",
  "private": true,
  "type": "module",
  "description": "Chrome extension: read Google Maps in the local language instead of your Google Account language.",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node test/e2e.mjs",
    "build": "node scripts/build.mjs",
    "gen:domains": "node scripts/gen-domains.mjs",
    "check:languages": "node scripts/check-languages.mjs",
    "setup:store": "node scripts/setup-store-secrets.mjs",
    "icons": "node scripts/render-icons.mjs",
    "assets": "node scripts/render-assets.mjs"
  },
  "devDependencies": {
    "puppeteer": "^25.16.0"
  },
  "engines": {
    "node": ">=20"
  }
}
